# =============================================================================
# PixelGuard backend — example environment file
# Copy to .env and edit. Never commit the real .env.
# =============================================================================

# ---------- Application ----------
APP_NAME=PixelGuard
APP_VERSION=1.0.0
DEBUG=False

# ---------- MongoDB ----------
# Local dev (docker-compose service "mongo"):
#   mongodb://mongo:27017
# Atlas:
#   mongodb+srv://USER:PASS@cluster.example.mongodb.net
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=pixelguard

# ---------- Security ----------
SECRET_KEY=please-change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------- CORS (comma-separated origins) ----------
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# ---------- File upload ----------
MAX_UPLOAD_SIZE=52428800
UPLOAD_DIR=./uploads

# ---------- Model ----------
MODEL_PATH=./models
MESSAGE_LENGTH=32
IMAGE_SIZE=256
